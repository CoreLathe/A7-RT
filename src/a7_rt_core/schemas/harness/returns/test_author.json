{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A7-RT Test Author Return",
  "description": "Return schema for test_author role",
  "type": "object",
  "required": [
    "node_id",
    "test_script"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "description": "ID of the node being tested"
    },
    "test_script": {
      "type": [
        "string",
        "null"
      ],
      "description": "Python test script content"
    },
    "contract_tested": {
      "type": "string",
      "description": "Description of what the test verifies"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_contract": {
      "type": "string",
      "description": "Structured behavioral contract passed to builder"
    }
  }
}